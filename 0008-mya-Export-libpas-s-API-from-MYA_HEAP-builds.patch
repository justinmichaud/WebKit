From 48a60dc6a7bd9aa81f320729612c6f89cbdc72c8 Mon Sep 17 00:00:00 2001
From: Justin Michaud <jmichaud@igalia.com>
Date: Tue, 6 Oct 2026 10:19:56 -0600
Subject: [PATCH 08/23] [mya] Export libpas's API from MYA_HEAP builds Need the
 bug URL (OOPS!).

Reviewed by NOBODY (OOPS!).

Build flags only. Builds with MYA_HEAP on (Debug macOS in Xcode; CMake with
ENABLE_MYA_HEAP).

libpas marks its API hidden when PAS_BMALLOC_HIDDEN is 1, its default, and
the Cocoa CMake build sets it explicitly. MYA_HEAP builds define
PAS_BMALLOC_HIDDEN=0 instead, so the pas_* functions are exported from the
image libpas is linked into.

Why it is needed: the heap walk accounts for every libpas allocation of the
target, which is how it measures what share of the heap it reaches and what
it misses. It gets them from pas_enumerator, libpas's own enumerator, run
inside libJavaScriptCoreTools over the snapshot's memory. On Linux, where libpas
makes no root for libmalloc, the walk also calls pas_root_create and
pas_heap_lock_lock/unlock to build the root it enumerates from. And the
HeapWalk tests enumerate their own process's heap the same way to check the
walk against it. All of these are calls from libJavaScriptCoreTools and
testLibJSCTools into libpas inside JavaScriptCore (or bmalloc), which need
the symbols exported.

Cost: libpas's symbols are visible from the JavaScriptCore image in MYA_HEAP
builds. Production builds are unaffected.

What we lose if it is not taken: libJavaScriptCoreTools fails to link once
the heap walk patch lands; that patch, and everything after it, needs this.

* Configurations/CommonBase.xcconfig:
* Source/bmalloc/PlatformCocoa.cmake:
* Source/cmake/WebKitCommon.cmake:

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Configurations/CommonBase.xcconfig | 3 ++-
 Source/bmalloc/PlatformCocoa.cmake | 4 +++-
 Source/cmake/WebKitCommon.cmake    | 2 ++
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/Configurations/CommonBase.xcconfig b/Configurations/CommonBase.xcconfig
index e1a5b92b37ca..468b3b65e420 100644
--- a/Configurations/CommonBase.xcconfig
+++ b/Configurations/CommonBase.xcconfig
@@ -96,7 +96,8 @@ OTHER_LDFLAGS = $(inherited) $(WK_COMMON_OTHER_LDFLAGS);
 // MYA_HEAP: mya features allowing the analysis of WebKit C++ heaps.
 WK_MYA_HEAP = NO;
 WK_MYA_HEAP[config=Debug][sdk=macosx*] = YES;
-WK_MYA_HEAP_PREPROCESSOR_DEFINITIONS_YES = ENABLE_MYA_HEAP=1;
+// PAS_BMALLOC_HIDDEN=0 exports libpas's API, which the heap walk's tests enumerate their own heap through.
+WK_MYA_HEAP_PREPROCESSOR_DEFINITIONS_YES = ENABLE_MYA_HEAP=1 PAS_BMALLOC_HIDDEN=0;
 
 WK_COMMON_OTHER_TAPI_FLAGS = -x objective-c++ -std=c++2b -fno-rtti $(WK_SANITIZER_OTHER_TAPI_FLAGS) $(WK_AVAILABILITY_OVERLAY_FLAGS);
 OTHER_TAPI_FLAGS = $(inherited) $(WK_COMMON_OTHER_TAPI_FLAGS);
diff --git a/Source/bmalloc/PlatformCocoa.cmake b/Source/bmalloc/PlatformCocoa.cmake
index 6b5d04308f7e..5c1ce25953e8 100644
--- a/Source/bmalloc/PlatformCocoa.cmake
+++ b/Source/bmalloc/PlatformCocoa.cmake
@@ -2,7 +2,9 @@ list(APPEND bmalloc_PUBLIC_HEADERS
     Configurations/module.modulemap
 )
 
-list(APPEND bmalloc_PRIVATE_DEFINITIONS PAS_BMALLOC_HIDDEN=1)
+if (NOT ENABLE_MYA_HEAP)
+    list(APPEND bmalloc_PRIVATE_DEFINITIONS PAS_BMALLOC_HIDDEN=1)
+endif ()
 
 list(APPEND bmalloc_SOURCES
     bmalloc/ProcessCheck.mm
diff --git a/Source/cmake/WebKitCommon.cmake b/Source/cmake/WebKitCommon.cmake
index 2035174bba22..8f9866a0df1c 100644
--- a/Source/cmake/WebKitCommon.cmake
+++ b/Source/cmake/WebKitCommon.cmake
@@ -367,6 +367,8 @@ if (NOT HAS_RUN_WEBKIT_COMMON)
             string(REPLACE "-mllvm -dwarf-linkage-names=Abstract" "" ${_flags} "${${_flags}}")
             string(REPLACE "-gsimple-template-names" "" ${_flags} "${${_flags}}")
         endforeach ()
+        # The heap walk's tests enumerate their own libpas heap, through libpas's API.
+        add_compile_definitions(PAS_BMALLOC_HIDDEN=0)
         if (NOT APPLE)
             # The build-id is what refuses an image rebuilt since it was loaded. lld
             # writes none unless asked, and only some distributions' clang asks.
