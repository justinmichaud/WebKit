diff --git a/Source/JavaScriptCore/CMakeLists.txt b/Source/JavaScriptCore/CMakeLists.txt
index 0e7fe5b58b3e..31280592b8db 100644
--- a/Source/JavaScriptCore/CMakeLists.txt
+++ b/Source/JavaScriptCore/CMakeLists.txt
@@ -1635,9 +1635,7 @@ if (USE_INSPECTOR_SOCKET_SERVER)
     )
 endif ()
 
-# The corpse memory-analysis support is built on Mach task and corpse APIs, so
-# its headers have no content off Darwin and there is nothing to build or export.
-if (APPLE)
+if (ENABLE_MYA)
     list(APPEND JavaScriptCore_PRIVATE_INCLUDE_DIRECTORIES
         "${JAVASCRIPTCORE_DIR}/corpse"
     )
@@ -1912,9 +1910,8 @@ add_dependencies(JavaScriptCoreSharedScripts JSCBuiltins)
 
 # The corpse code is part of JavaScriptCoreTools, which ships as a static library used
 # only by tools for assisting in the development of JavaScriptCore and WebKit. This code
-# is not needed for JavaScriptCore and WebKit functionality as a browser engine. The
-# corpse code rely on Mach APIs which are only available on Apple platforms.
-if (APPLE)
+# is not needed for JavaScriptCore and WebKit functionality as a browser engine.
+if (ENABLE_MYA)
   add_subdirectory(corpse)
 endif ()
 
diff --git a/Source/JavaScriptCore/Configurations/JSC.xcconfig b/Source/JavaScriptCore/Configurations/JSC.xcconfig
index 48ea6dd500cc..57602d0d7970 100644
--- a/Source/JavaScriptCore/Configurations/JSC.xcconfig
+++ b/Source/JavaScriptCore/Configurations/JSC.xcconfig
@@ -44,6 +44,11 @@ CODE_SIGN_INJECT_BASE_ENTITLEMENTS[sdk=macosx*] = NO;
 OTHER_CODE_SIGN_FLAGS[sdk=iphone*] = -i com.apple.jsc --entitlements ${WK_PROCESSED_XCENT_FILE};
 OTHER_CODE_SIGN_FLAGS[sdk=macosx*] = --entitlements ${WK_PROCESSED_XCENT_FILE};
 
+ENTITLEMENTS_REQUIRED = $(ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_$(USE_INTERNAL_SDK));
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_ = NO;
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_NO = NO;
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_YES = $(ENTITLEMENTS_REQUIRED);
+
 // Explicitly add the PrivateHeaders directory to the search path so that generated header files can be found in production builds.
 HEADER_SEARCH_PATHS = "$(JAVASCRIPTCORE_FRAMEWORKS_DIR)/JavaScriptCore.framework/PrivateHeaders" $(inherited);
 HEADER_SEARCH_PATHS = "${BUILT_PRODUCTS_DIR}/DerivedSources/JavaScriptCore" $(HEADER_SEARCH_PATHS);
diff --git a/Source/JavaScriptCore/Configurations/TestExecutable.xcconfig b/Source/JavaScriptCore/Configurations/TestExecutable.xcconfig
index e2a6eb2469c3..180735644f28 100644
--- a/Source/JavaScriptCore/Configurations/TestExecutable.xcconfig
+++ b/Source/JavaScriptCore/Configurations/TestExecutable.xcconfig
@@ -32,6 +32,11 @@ CODE_SIGN_INJECT_BASE_ENTITLEMENTS[sdk=macosx*] = NO;
 OTHER_CODE_SIGN_FLAGS[sdk=iphone*] = -i com.apple.jsc --entitlements ${WK_PROCESSED_XCENT_FILE};
 OTHER_CODE_SIGN_FLAGS[sdk=macosx*] = --entitlements ${WK_PROCESSED_XCENT_FILE};
 
+ENTITLEMENTS_REQUIRED = $(ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_$(USE_INTERNAL_SDK));
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_ = NO;
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_NO = NO;
+ENTITLEMENTS_REQUIRED_USE_INTERNAL_SDK_YES = $(ENTITLEMENTS_REQUIRED);
+
 SKIP_INSTALL = $(SKIP_INSTALL_$(FORCE_TOOL_INSTALL));
 SKIP_INSTALL_ = YES;
 SKIP_INSTALL_NO = YES;
diff --git a/Source/JavaScriptCore/Configurations/libJavaScriptCoreTools.xcconfig b/Source/JavaScriptCore/Configurations/libJavaScriptCoreTools.xcconfig
index 6c9d6d091079..406c72b658e3 100644
--- a/Source/JavaScriptCore/Configurations/libJavaScriptCoreTools.xcconfig
+++ b/Source/JavaScriptCore/Configurations/libJavaScriptCoreTools.xcconfig
@@ -56,3 +56,8 @@ STRIP_INSTALLED_PRODUCT = NO;
 // The sources include "config.h" and their own headers from the source tree,
 // plus JavaScriptCore's generated and private headers.
 HEADER_SEARCH_PATHS = $(SRCROOT) $(SRCROOT)/corpse "$(JAVASCRIPTCORE_FRAMEWORKS_DIR)/JavaScriptCore.framework/PrivateHeaders" $(inherited);
+
+// A heap walk reads every value of a heap through WTF's containers, which at
+// -O0 makes a walk of a small heap take twice as long. JavaScriptCore itself
+// stays as the configuration says.
+WK_DEFAULT_GCC_OPTIMIZATION_LEVEL[config=Debug] = 2;
diff --git a/Source/JavaScriptCore/Scripts/process-entitlements.sh b/Source/JavaScriptCore/Scripts/process-entitlements.sh
index 8e8c00f5d4ff..ad473d3721fc 100755
--- a/Source/JavaScriptCore/Scripts/process-entitlements.sh
+++ b/Source/JavaScriptCore/Scripts/process-entitlements.sh
@@ -86,6 +86,14 @@ function mac_process_mya_entitlements()
     fi
 }
 
+function mac_process_testLibJSCTools_entitlements()
+{
+    if [[ "${RC_XBS}" != YES && "${WK_USE_RESTRICTED_ENTITLEMENTS}" != YES ]]
+    then
+        plistbuddy Add :com.apple.security.get-task-allow bool YES
+    fi
+}
+
 # ========================================
 # macCatalyst entitlements
 # ========================================
@@ -236,8 +244,7 @@ then
           "${PRODUCT_NAME}" == testRegExp ]]; then mac_process_jsc_entitlements
     elif [[ "${PRODUCT_NAME}" == testapi ]]; then mac_process_testapi_entitlements
     elif [[ "${PRODUCT_NAME}" == mya ]]; then mac_process_mya_entitlements
-    # testLibJSCTools only ever snapshots its own process, which needs no entitlement.
-    elif [[ "${PRODUCT_NAME}" == testLibJSCTools ]]; then true
+    elif [[ "${PRODUCT_NAME}" == testLibJSCTools ]]; then mac_process_testLibJSCTools_entitlements
     else echo "Unsupported/unknown product: ${PRODUCT_NAME}"
     fi
 elif [[ "${WK_PLATFORM_NAME}" == maccatalyst || "${WK_PLATFORM_NAME}" == iosmac ]]
diff --git a/Source/JavaScriptCore/corpse/CMakeLists.txt b/Source/JavaScriptCore/corpse/CMakeLists.txt
index 42c529add0ba..f3f240aa558f 100644
--- a/Source/JavaScriptCore/corpse/CMakeLists.txt
+++ b/Source/JavaScriptCore/corpse/CMakeLists.txt
@@ -31,3 +31,10 @@ WEBKIT_LIBRARY(JavaScriptCoreTools)
 
 # The corpse sources use JavaScriptCore's generated headers.
 add_dependencies(JavaScriptCoreTools JavaScriptCore)
+
+# A heap walk reads every value of a heap through WTF's containers, which at
+# -O0 makes a walk of a small heap take twice as long. JavaScriptCore itself
+# stays as the build type says.
+if (CMAKE_BUILD_TYPE STREQUAL "Debug")
+    target_compile_options(JavaScriptCoreTools PRIVATE -O2)
+endif ()
