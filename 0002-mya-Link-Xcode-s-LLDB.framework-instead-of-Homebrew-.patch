From 3d86c5ef95e34f769880e1c62817e323e2269f31 Mon Sep 17 00:00:00 2001
From: Justin Michaud <jmichaud@igalia.com>
Date: Tue, 6 Oct 2026 10:19:56 -0600
Subject: [PATCH 02/23] [mya] Link Xcode's LLDB.framework instead of Homebrew's
 liblldb in MYA_HEAP Xcode builds Need the bug URL (OOPS!).

Reviewed by NOBODY (OOPS!).

Build flags only.

MYA_HEAP Xcode builds linked libJavaScriptCoreTools, mya and testLibJSCTools
against Homebrew's liblldb.dylib (-L$(brew)/llvm/lib -llldb). They now link
LLDB.framework from the active Xcode (DEVELOPER_DIR/../SharedFrameworks),
with an rpath to it and to the Command Line Tools' copy. The SB API headers
still come from Homebrew's llvm, since Xcode does not ship them; the SB API is
binary compatible across versions, which is its purpose.

Why it is needed:
- Homebrew's liblldb crashes reading WebCore's debug info (WebCore is far
  larger than anything Homebrew's LLDB is exercised on); Xcode's LLDB, which
  Apple uses to debug WebKit every day, reads it.
- Xcode's LLDB reads the debug info Xcode's clang writes, including the
  compilation-caching references in object files, by construction.

What we lose if it is not taken: on macOS, the heap walk (and the DebugInfo
suite) cannot open WebCore's debug info, so `mya heap` in a WebContent
process fails; jsc-only heaps mostly still work with Homebrew's liblldb.

* Source/JavaScriptCore/Configurations/Base.xcconfig:
* Source/JavaScriptCore/corpse/CorpseSnapshot.cpp:

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Source/JavaScriptCore/Configurations/Base.xcconfig | 7 +++++--
 Source/JavaScriptCore/corpse/CorpseSnapshot.cpp    | 4 ++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/Source/JavaScriptCore/Configurations/Base.xcconfig b/Source/JavaScriptCore/Configurations/Base.xcconfig
index cefce1d7c216..4b091d1ad053 100644
--- a/Source/JavaScriptCore/Configurations/Base.xcconfig
+++ b/Source/JavaScriptCore/Configurations/Base.xcconfig
@@ -156,15 +156,18 @@ WK_PROCESSED_XCENT_FILE=$(TEMP_FILE_DIR)/$(FULL_PRODUCT_NAME).entitlements
 WK_USE_RESTRICTED_ENTITLEMENTS = $(USE_INTERNAL_SDK);
 WK_USE_FATAL_EXCEPTIONS = $(OVERRIDE_WK_USE_FATAL_EXCEPTIONS:default=YES);
 
-// We support HomeBrew installs of liblldb, since the version in the system sdk is not public API.
+// Xcode's LLDB.framework ships without the SB API headers, so they come from a HomeBrew llvm.
+// The SB API is binary compatible across versions.
 WK_BREW_PREFIX = /opt/homebrew/opt;
 WK_BREW_PREFIX[arch=x86_64] = /usr/local/opt;
 
 WK_LLDB_SYSTEM_HEADER_SEARCH_PATHS = $(WK_LLDB_SYSTEM_HEADER_SEARCH_PATHS_$(WK_MYA_HEAP));
 WK_LLDB_SYSTEM_HEADER_SEARCH_PATHS_YES = $(WK_BREW_PREFIX)/llvm/include;
 
+WK_LLDB_FRAMEWORK_DIR = $(DEVELOPER_DIR)/../SharedFrameworks;
+WK_LLDB_COMMAND_LINE_TOOLS_FRAMEWORK_DIR = /Library/Developer/CommandLineTools/Library/PrivateFrameworks;
 WK_LLDB_LDFLAGS = $(WK_LLDB_LDFLAGS_$(WK_MYA_HEAP));
-WK_LLDB_LDFLAGS_YES = -L$(WK_BREW_PREFIX)/llvm/lib;
+WK_LLDB_LDFLAGS_YES = -F$(WK_LLDB_FRAMEWORK_DIR) -Wl,-rpath,$(WK_LLDB_FRAMEWORK_DIR) -Wl,-rpath,$(WK_LLDB_COMMAND_LINE_TOOLS_FRAMEWORK_DIR);
 
 // Shared variables used for dynamic or static linking of JavaScriptCore and jsc.
 
diff --git a/Source/JavaScriptCore/corpse/CorpseSnapshot.cpp b/Source/JavaScriptCore/corpse/CorpseSnapshot.cpp
index 95a53cf140e0..667bcced429a 100644
--- a/Source/JavaScriptCore/corpse/CorpseSnapshot.cpp
+++ b/Source/JavaScriptCore/corpse/CorpseSnapshot.cpp
@@ -38,8 +38,8 @@
 #include <wtf/TZoneMallocInlines.h>
 
 #if HAVE(LLDB) && OS(DARWIN) && !defined(BUILDING_WITH_CMAKE)
-// Xcode has no optional dependencies, so liblldb is linked only when its headers are found.
-__asm__(".linker_option \"-llldb\"");
+// Xcode has no optional dependencies, so LLDB.framework is linked only when liblldb's headers are found.
+__asm__(".linker_option \"-framework\", \"LLDB\"");
 #endif
 
 WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
